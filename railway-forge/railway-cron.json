{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["/railway-forge/**"]
  },
  "deploy": {
    "startCommand": "python3 cron.py",
    "cronSchedule": "*/5 * * * *",
    "numReplicas": 1,
    "restartPolicyType": "NEVER"
  }
}
