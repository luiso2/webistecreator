{
  "name": "siteforge-panel",
  "main": "worker.js",
  "workers_dev": true,
  "routes": [
    { "pattern": "siteforge.merktop.com", "custom_domain": true },
    { "pattern": "siteforce.merktop.com", "custom_domain": true }
