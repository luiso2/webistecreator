{
  "name": "siteforge-panel",
  "main": "worker.js",
  "workers_dev": true,
  "routes": [
    { "pattern": "siteforge.merktop.com", "custom_domain": true },
    { "pattern": "siteforce.merktop.com", "custom_domain": true }
  ],
  // CF_REGISTRAR_TOKEN y RESEND_API_KEY van como SECRET, nunca como var del dashboard:
  //   npx wrangler secret put CF_REGISTRAR_TOKEN -c ui/wrangler.jsonc
  // Un `wrangler deploy` REEMPLAZA las vars del worker por las de este archivo, asi que una
  // var puesta a mano en el dashboard se pierde en el siguiente deploy (paso el 2026-08-11:
  // se borro CF_REGISTRAR_TOKEN y la busqueda de dominios dejo de funcionar). Los secrets
  // sobreviven a los deploys. Nunca poner el valor aqui: este archivo esta en git.
  "compatibility_date": "2026-08-22",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "persist": true }
  },
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "CF_ACCOUNT_ID": "e79469132f614c7f418a0e7a65466e88" },
  "assets": { "directory": "public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "QUEUE_CLAIMS", "class_name": "QueueClaims" },
      { "name": "OUTREACH_CAMPAIGN", "class_name": "OutreachCampaign" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QueueClaims"] },
    { "tag": "v2", "new_sqlite_classes": ["OutreachCampaign"] }],
  "kv_namespaces": [
    { "binding": "SITEFORGE_KV", "id": "3a40823222b6421fafe3969982345792" }
  ]
}
